<Window x:Class="Avtokolonna1456.PasswordManager.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Резервные копии"
        Height="460" Width="620"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Резервные копии" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"
                       Text="Копии хранятся локально и восстанавливаются только под этой учётной записью Windows." />
        </StackPanel>

        <ListBox x:Name="BackupList" Grid.Row="1"
                 DisplayMemberPath="Display"
                 Foreground="{DynamicResource Brush.Text}"
                 BorderBrush="{DynamicResource Brush.Border}"
                 Background="{DynamicResource Brush.Surface}"
                 Padding="6" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Создать копию" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Create_Click" />
            <Button Content="Восстановить" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Restore_Click" />
            <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
