<Window x:Class="Avtokolonna1456.PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Автоколонна 1456 — Менеджер паролей"
        Height="700" Width="1120"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Автоколонна 1456"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Менеджер паролей"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Search input with placeholder and clear button -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource ModernTextBox}"
                             Padding="10,8,32,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по названию или логину" />
                    <TextBlock Text="Поиск по названию или логину..."
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="12,0,32,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="×"
                            Style="{StaticResource IconActionButton}"
                            FontSize="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                            ToolTip="Очистить поиск" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Добавить пароль"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"
                            Margin="0,0,8,0" />
                    <Button x:Name="MenuButton"
                            Content="⋯"
                            FontSize="16"
                            Style="{StaticResource SecondaryButton}"
                            Width="42"
                            Click="MenuButton_Click"
                            ToolTip="Дополнительные действия и настройки" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Всего паролей" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="В порядке" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="{Binding OkCount}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.StatusOk}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Скоро обновить" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="{Binding WarningCount}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.StatusWarning}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Просрочены" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="{Binding ExpiredCount}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.StatusExpired}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Passwords Table Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Toolbar -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TableHeaderText}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Редактировать"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    Command="{Binding EditCommand}" />
                            <Button Content="Удалить"
                                    Style="{StaticResource DangerOutlineButton}"
                                    Padding="12,6"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Table + Empty States -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="PasswordsGrid"
                              ItemsSource="{Binding RowsView}"
                              SelectedItem="{Binding Selected}"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding Title}"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                Width="1.4*"
                                                MinWidth="150" />

                            <DataGridTemplateColumn Header="Логин" SortMemberPath="Login" Width="1.2*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource IconActionButton}"
                                                    Command="{Binding DataContext.CopyLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Копировать логин">
                                                <Path Width="14" Height="14" Stretch="Uniform"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M19,21H8V7H19V21Z" />
                                            </Button>
                                            <TextBlock Text="{Binding Login}"
                                                       Style="{StaticResource CellTextStyle}"
                                                       Margin="0,0,6,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Пароль" Width="1.4*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource IconActionButton}"
                                                        Command="{Binding DataContext.TogglePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Показать или скрыть пароль">
                                                    <Path Width="15" Height="15" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" />
                                                </Button>
                                                <Button Style="{StaticResource IconActionButton}"
                                                        Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Копировать пароль (очистка через 30 сек)">
                                                    <Path Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Data="M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M19,21H8V7H19V21Z" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayPassword}"
                                                       Style="{StaticResource CellTextStyle}"
                                                       FontFamily="Consolas"
                                                       Margin="0,0,6,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Последняя смена"
                                                Binding="{Binding LastChangedAt, StringFormat=dd.MM.yyyy}"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                Width="125"
                                                MinWidth="110" />

                            <DataGridTextColumn Header="Возраст"
                                                Binding="{Binding AgeDays, StringFormat={}{0} дн.}"
                                                SortMemberPath="AgeDays"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                Width="85"
                                                MinWidth="75" />

                            <DataGridTextColumn Header="Осталось"
                                                Binding="{Binding DaysRemainingText}"
                                                SortMemberPath="DaysRemaining"
                                                ElementStyle="{StaticResource CellTextStyle}"
                                                Width="115"
                                                MinWidth="95" />

                            <DataGridTemplateColumn Header="Статус" SortMemberPath="DaysRemaining" Width="140" MinWidth="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                CornerRadius="10"
                                                Padding="10,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Редактировать" Command="{Binding EditCommand}" />
                                <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Empty State: no passwords yet (kept below 40px DataGrid headers) -->
                    <Border Margin="0,42,0,0"
                            Background="{DynamicResource Brush.Surface}"
                            Visibility="{Binding ShowNoPasswordsState, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
                            <TextBlock Text="Паролей пока нет"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Добавьте первую запись, и таблица сразу отобразит логин, пароль и отсчёт 90 дней до обновления."
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,18" />
                            <Button Content="+ Добавить первый пароль"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding AddCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Empty State: search returned no rows -->
                    <Border Margin="0,42,0,0"
                            Background="{DynamicResource Brush.Surface}"
                            Visibility="{Binding ShowNoSearchResultsState, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="24">
                            <TextBlock Text="Ничего не найдено"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="По текущему запросу совпадений нет."
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextAlignment="Center"
                                       Margin="0,6,0,16" />
                            <Button Content="Сбросить поиск"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ClearSearchCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Transient status bar -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="14,8"
                CornerRadius="8"
                Background="{DynamicResource Brush.AccentSoft}"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />
        </Border>

        <!-- Overflow Menu Popup -->
        <Popup x:Name="ActionsPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=MenuButton}"
               HorizontalOffset="-198"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Style="{StaticResource CardBorder}" Width="240" Margin="0,8,0,0">
                <StackPanel>
                    <Button Content="Резервные копии"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,8"
                            Command="{Binding BackupCommand}"
                            Click="ClosePopup_Click" />
                    <Button Content="Проверить напоминания"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,10"
                            Command="{Binding CheckRemindersCommand}"
                            Click="ClosePopup_Click" />
                    <Separator Background="{DynamicResource Brush.Border}" Margin="0,0,0,10" />
                    <CheckBox Content="Тёмная тема"
                              IsChecked="{Binding DarkTheme}"
                              Margin="2,2,0,8" />
                    <CheckBox Content="Автозапуск с Windows"
                              IsChecked="{Binding AutostartEnabled}"
                              Margin="2,0,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
