<Window x:Class="Avtokolonna1456.PasswordManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоколонна 1456 — Менеджер паролей"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}">
    <Grid Margin="24">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Автоколонна 1456" FontSize="13"
                                   Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                        <TextBlock Text="Менеджер паролей" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             VerticalAlignment="Center"
                             Margin="16,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по названию или логину" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Добавить пароль" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddCommand}" Margin="0,0,8,0" />
                        <Button x:Name="MenuButton" Content="⋯" Style="{StaticResource SecondaryButton}" Width="42"
                                Click="MenuButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Всего паролей" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="В порядке" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding OkCount}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.StatusOk}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Скоро обновить" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding WarningCount}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.StatusWarning}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Просрочены" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding ExpiredCount}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.StatusExpired}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding Selected}"
                          CanUserSortColumns="True"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="1.4*" />
                        <DataGridTemplateColumn Header="Логин" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="⧉" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.CopyLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Копировать логин" />
                                        <TextBlock Text="{Binding Login}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Пароль" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="👁" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.TogglePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Показать/скрыть" />
                                            <Button Content="⧉" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Копировать пароль (очистка через 30 сек)" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayPassword}" VerticalAlignment="Center"
                                                   FontFamily="Consolas" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Последняя смена" Binding="{Binding LastChangedAt, StringFormat=dd.MM.yyyy}" Width="120" />
                        <DataGridTextColumn Header="Возраст" Binding="{Binding AgeDays}" Width="80" />
                        <DataGridTextColumn Header="Осталось" Binding="{Binding DaysRemainingText}" Width="110" />
                        <DataGridTemplateColumn Header="Статус" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                            CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Редактировать" Command="{Binding EditCommand}" />
                            <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>
        </DockPanel>

        <Popup x:Name="ActionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=MenuButton}"
               StaysOpen="False" AllowsTransparency="True">
            <Border Style="{StaticResource CardBorder}" Width="240" Margin="0,8,0,0">
                <StackPanel>
                    <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                            Command="{Binding EditCommand}" Click="ClosePopup_Click" />
                    <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                            Command="{Binding DeleteCommand}" Click="ClosePopup_Click" />
                    <Button Content="Резервные копии" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                            Command="{Binding BackupCommand}" Click="ClosePopup_Click" />
                    <Button Content="Проверить напоминания" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"
                            Command="{Binding CheckRemindersCommand}" Click="ClosePopup_Click" />
                    <CheckBox Content="Тёмная тема" IsChecked="{Binding DarkTheme}" Margin="4,4,0,8" />
                    <CheckBox Content="Автозапуск с Windows" IsChecked="{Binding AutostartEnabled}" Margin="4,0,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
