<Window x:Class="Avtokolonna1456.PasswordManager.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоколонна 1456 — Вход"
        Height="640" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}"
        KeyDown="Window_KeyDown">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,20">
            <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Center">
                <TextBlock Text="1456" Foreground="White" FontWeight="Bold" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Автоколонна 1456" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock Text="Менеджер паролей" Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="TitleText" Grid.Row="1" Text="Введите PIN"
                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />

        <StackPanel x:Name="DotsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Ellipse x:Name="Dot0" Width="14" Height="14" Margin="8" Fill="{DynamicResource Brush.Border}" />
            <Ellipse x:Name="Dot1" Width="14" Height="14" Margin="8" Fill="{DynamicResource Brush.Border}" />
            <Ellipse x:Name="Dot2" Width="14" Height="14" Margin="8" Fill="{DynamicResource Brush.Border}" />
            <Ellipse x:Name="Dot3" Width="14" Height="14" Margin="8" Fill="{DynamicResource Brush.Border}" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center"
                   TextAlignment="Center" MinHeight="36" Margin="0,0,0,8" />

        <UniformGrid Grid.Row="4" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button Content="1" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="1" />
            <Button Content="2" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="2" />
            <Button Content="3" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="3" />
            <Button Content="4" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="4" />
            <Button Content="5" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="5" />
            <Button Content="6" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="6" />
            <Button Content="7" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="7" />
            <Button Content="8" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="8" />
            <Button Content="9" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="9" />
            <Button Content="⌫" Style="{StaticResource PinKeyButton}" Click="Backspace_Click" />
            <Button Content="0" Style="{StaticResource PinKeyButton}" Click="Digit_Click" Tag="0" />
            <Button Content="OK" Style="{StaticResource PinKeyButton}" Click="Ok_Click" />
        </UniformGrid>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <Button x:Name="RecoveryButton" Content="Забыли PIN? Восстановить"
                    Style="{StaticResource GhostButton}" Click="Recovery_Click"
                    HorizontalAlignment="Center" />
            <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBox x:Name="RecoveryCodeBox" Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,8" ToolTip="Резервный код" />
                <TextBlock Text="Новый PIN (4 цифры)" Margin="0,0,0,6"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <PasswordBox x:Name="NewPinBox" Style="{StaticResource ModernPasswordBox}" MaxLength="4" Margin="0,0,0,8" />
                <Button Content="Сбросить PIN" Style="{StaticResource PrimaryButton}" Click="ResetPin_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
