<Window x:Class="Avtokolonna1456.PasswordManager.Views.PasswordEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Пароль"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           Text="Добавить пароль"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock Text="Данные хранятся локально в зашифрованном виде."
                           FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,16">
                <TextBlock Text="Название"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBox x:Name="TitleBox"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,14" />

                <TextBlock Text="Логин"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBox x:Name="LoginBox"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,14" />

                <TextBlock Text="Пароль"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordHidden" Style="{StaticResource ModernPasswordBox}" />
                    <TextBox x:Name="PasswordVisible" Style="{StaticResource ModernTextBox}" Visibility="Collapsed" />
                    <Button x:Name="TogglePasswordButton"
                            Grid.Column="1"
                            Content="Показать"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            MinWidth="92"
                            Click="TogglePassword_Click" />
                </Grid>

                <TextBlock Text="Дата последней смены"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <DatePicker x:Name="ChangedDatePicker" Margin="0,0,0,6" />
                <TextBlock Text="Срок обновления — 90 календарных дней от этой даты."
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="12"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Brush.Danger}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        MinWidth="96"
                        IsCancel="True" />
                <Button Content="Сохранить"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="112"
                        Click="Save_Click"
                        IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
