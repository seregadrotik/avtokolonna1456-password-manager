<Window x:Class="Avtokolonna1456.PasswordManager.Views.PasswordEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пароль"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Добавить пароль" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Название" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBox x:Name="TitleBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />

            <TextBlock Text="Логин" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBox x:Name="LoginBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />

            <TextBlock Text="Пароль" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextSecondary}" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordHidden" Style="{StaticResource ModernPasswordBox}" />
                <TextBox x:Name="PasswordVisible" Style="{StaticResource ModernTextBox}" Visibility="Collapsed" />
                <Button Grid.Column="1" Content="👁" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Width="42" Click="TogglePassword_Click" />
            </Grid>

            <TextBlock Text="Дата последней смены" Margin="0,0,0,6" Foreground="{DynamicResource Brush.TextSecondary}" />
            <DatePicker x:Name="ChangedDatePicker" Margin="0,0,0,8" />
            <TextBlock Text="Срок обновления — 90 календарных дней от этой даты."
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
