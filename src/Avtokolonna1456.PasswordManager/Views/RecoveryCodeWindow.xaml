<Window x:Class="Avtokolonna1456.PasswordManager.Views.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Резервный код"
        Height="360" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}"
        Closing="Window_Closing">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Сохраните резервный код" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16"
                       Text="Этот код понадобится, если вы забудете PIN. Храните его отдельно от компьютера. Код больше не будет показан." />
            <Border Style="{StaticResource CardBorder}" Background="{DynamicResource Brush.AccentSoft}">
                <TextBlock x:Name="CodeText" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" FontFamily="Consolas" />
            </Border>
            <CheckBox x:Name="ConfirmCheck" Margin="0,18,0,0"
                      Content="Я сохранил(а) резервный код в надёжном месте" />
            <Button Content="Продолжить" Style="{StaticResource PrimaryButton}"
                    Margin="0,18,0,0" HorizontalAlignment="Right" Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
