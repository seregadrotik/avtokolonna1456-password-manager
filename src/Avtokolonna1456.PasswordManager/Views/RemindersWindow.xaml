<Window x:Class="Avtokolonna1456.PasswordManager.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Напоминания"
        Height="440" Width="540"
        MinHeight="340" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Требуют внимания" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="Пароли со сроком 7 дней и меньше."
                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" />
        </StackPanel>
        <ListBox x:Name="ReminderList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center"
                                    Background="{Binding StatusBrush}">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Content="Понятно" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Margin="0,12,0,0" IsDefault="True" Click="Close_Click" />
    </Grid>
</Window>
