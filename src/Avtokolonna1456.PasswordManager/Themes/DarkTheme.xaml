<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Window">#FF161920</Color>
    <Color x:Key="Color.Surface">#FF1F242E</Color>
    <Color x:Key="Color.SurfaceAlt">#FF262C38</Color>
    <Color x:Key="Color.HeaderBg">#FF2B3240</Color>
    <Color x:Key="Color.Border">#FF3A4354</Color>
    <Color x:Key="Color.Text">#FFF2F4F8</Color>
    <Color x:Key="Color.TextSecondary">#FFA5B0C2</Color>
    <Color x:Key="Color.Accent">#FF3B8DD6</Color>
    <Color x:Key="Color.AccentHover">#FF55A2E6</Color>
    <Color x:Key="Color.AccentSoft">#FF243850</Color>
    <Color x:Key="Color.Danger">#FFDC4C3E</Color>
    <Color x:Key="Color.Ok">#FF15803D</Color>
    <Color x:Key="Color.Warning">#FFB45309</Color>
    <Color x:Key="Color.Urgent">#FFEA580C</Color>
    <Color x:Key="Color.Today">#FFDC2626</Color>
    <Color x:Key="Color.Expired">#FFDC2626</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="{StaticResource Color.HeaderBg}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.StatusOk" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.StatusUrgent" Color="{StaticResource Color.Urgent}" />
    <SolidColorBrush x:Key="Brush.StatusToday" Color="{StaticResource Color.Today}" />
    <SolidColorBrush x:Key="Brush.StatusExpired" Color="{StaticResource Color.Expired}" />
</ResourceDictionary>
